# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# ── Dados brutos (não versionar — baixados pelo scraper) ──
data/raw/

# ── Dados processados e geo SÃO versionados ──────────────
# Necessário para o Streamlit Cloud funcionar sem rodar o scraper
# data/processed/  ← removido do gitignore
data/geo/*.shp
data/geo/*.dbf
data/geo/*.shx
data/geo/*.prj
data/geo/*.cpg

# Malhas baixadas sob demanda (demais UFs); MG continua versionado
data/geo/*.geojson
!data/geo/municipios_mg.geojson

# ── Streamlit secrets (nunca versionar!) ───────
.streamlit/secrets.toml

# ── Variáveis de ambiente ──────────────────────
.env
.env.local

# ── ChromeDriver / Selenium ────────────────────
chromedriver
geckodriver

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── IDEs ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

check_*.py
debug_*.py
fix_*.py
inspecionar_*.py
setup_dados.py
